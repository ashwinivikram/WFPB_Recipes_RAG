      "4 to 6 baby carrots"
    ],
    "mushrooms": [],
    "nuts_seeds_avocados": [
      "2 Tbsp flaxseed powder",
      "3 tsp chia seeds"
    ],
    "fruits": [],
    "berries": [],
    "tubers": [],
    "herbs_spices": [
      "2 Thai chili",
      "½ Tbsp coriander powder",
      "½ tsp red chilli powder",
      "1 tsp Garam Masala",
      "1 tsp khatai (amchoor | raw mango powder)",
      "Salt (to taste; approx. 1/8 tsp)"
    ],
    "lime_lemon_vinegar": [],
    "sweeteners": []
  },
  "all_ingredients_flat": "1 medium size bottle gourd, ½ cup whole black gram flour, 2 Tbsp flaxseed powder, 3 tsp chia seeds, ⅓ cup rolled oats, 4 to 6 baby carrots, 2 sprigs cilantro, 2 Thai chili, ½ Tbsp coriander powder, ½ tsp red chilli powder, 1 tsp Garam Masala, 1 tsp khatai, Salt",
  "instructions": "1) Blend all ingredients in the food processor at low speed. Make sure that the mixture is slightly coarse, and not watery or runny.\n2) Scoop approx. 2-inch diameter dollops of the mixture onto non-stick foil. Bake for 7 mins at 350 F. Then flip them over with a silicone spatula and bake at 325 F for 9 mins or so.",
  "cooking_methods": [
    "blend",
    "bake"
  ],
  "serving_suggestion": "Serve with Mint Cilantro Chutney and Date Tamarind Chutney!",
