      "1/2 cup chana dal",
      "1/2 cup toor dal",
      "1/2 cup moong dal"
    ],
    "leafy_greens": [
      "chopped leafy greens (4 cups)",
      "cilantro"
    ],
    "rainbow_veggies": [
      "tomatoes",
      "onions",
      "bell pepper",
      "corn (optional)",
      "grated squash (optional)"
    ],
    "mushrooms": [],
