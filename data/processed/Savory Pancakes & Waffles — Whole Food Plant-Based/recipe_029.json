{
  "recipe_name": "Gujarati Handvo",
  "creator": "Sharmila Vedam",
  "category": "Baked Dish",
  "subcategory": "",
  "ingredients": {
    "whole_grains": [
      "1 cup brown rice (coarsely powdered)"
    ],
    "beans_legumes": [
      "1/2 cup chana dal",
      "1/2 cup moong dal",
      "1/4 cup toor dal (coarsely powdered)",
      "1/4 cup ground peanuts (coarsely powdered) - optional",
      "1/2 cup soy yogurt"
    ],
    "leafy_greens": [
      "Curry leaves"
    ],
    "rainbow_veggies": [
      "1 Tbsp grated ginger",
      "Ground green chillies",
      "1 Tbsp minced garlic",
      "1/2 cup shredded zucchini (or opo squash)",
      "1/2 cup shredded beetroot"
    ],
    "mushrooms": [],
    "nuts_seeds_avocados": [
      "2 Tbsp white sesame seeds",
      "1/4 cup ground peanuts (coarsely powdered) - optional",
      "1 Tbsp mustard seeds",
      "1 Tbsp sesame seeds"
    ],
    "fruits": [],
    "berries": [],
    "tubers": [],
    "herbs_spices": [
      "2 tsp turmeric powder",
      "2 tsp red chili powder",
      "1/2 Tbsp coriander powder",
      "1/2 Tbsp cumin powder",
      "1 Tbsp Garam Masala",
      "Salt",
      "1 tsp baking soda or ENO fruit salt",
      "1/4 tsp asafetida (hing)"
    ],
    "lime_lemon_vinegar": [
      "lemon juice"
    ],
    "sweeteners": []
  },
  "all_ingredients_flat": "brown rice (coarsely powdered), chana dal, moong dal, toor dal (coarsely powdered), minced garlic, turmeric powder, red chili powder, coriander powder, cumin powder, Garam Masala, white sesame seeds, grated ginger, ground green chillies, ground peanuts (coarsely powdered) - optional, salt, baking soda or ENO fruit salt, soy yogurt, shredded zucchini (or opo squash), shredded beetroot, water, mustard seeds, sesame seeds, asafetida (hing), curry leaves, lemon juice",
  "instructions": "(1) Coarsely powder brown rice & all the dals. (2) Blend green chillies (according to your preference), garlic and ginger. (3) Add various spices, soy yogurt, ginger/garlic/green chilli paste and add warm water to make a thick batter. (4) Add sesame seeds and peanut powder. Mix well without any lumps. (5) Set aside for 5-6 hrs for fermentation. (6) After the batter has fermented, add grated zucchini, beets, salt [to taste], lemon juice, and baking soda (or ENO salt).\n\nTEMPERING (Preparation):\nDry roast all the ingredients. Add water at the end.\n\nTEMPERING (Cooking):\nBAKE: Transfer the batter into silicon muffin pan. Add tempering (made mustard seeds, sesame seeds, curry leaves, ...) as topping on the batter. Bake at 350 F for almost 45-60 mins. Check after 35 mins (by inserting a toothpick). If not done then let bake for another 10-20 mins.",
  "cooking_methods": [
    "powder",
    "blend",
    "mix",
    "ferment",
    "dry roast",
    "bake"
  ],
  "serving_suggestion": "Enjoy with Homemade Ketchup.",
  "notes": "A recipe with WHOLE GRAINS (brown rice), BEANS (chana dal, moong dal, toor dal, soy yogurt), RAINBOW VEGGIES (zucchini, beetroot), NUTS & SEEDS (sesame seeds, peanuts), HERBS & & SPICES (various).",
