{
  "recipe_name": "Amaranth Greens & Chana Dal Vada",
  "creator": "Dr Sirisha Potluri",
  "category": "Snack",
  "subcategory": "",
  "ingredients": {
    "whole_grains": [],
    "beans_legumes": [
      "2 cups split chickpeas (chana dal)"
    ],
    "leafy_greens": [
      "3-4 cups amaranth greens",
      "1 cup chopped cilantro",
      "2 Tbsp curry leaves"
    ],
    "rainbow_veggies": [
      "2 onions",
      "2 Tbsp green chili",
      "1 Tbsp grated ginger"
    ],
    "mushrooms": [],
    "nuts_seeds_avocados": [
      "1 Tbsp cumin seeds",
      "1-2 tsp fennel seeds",
      "1 Tbsp ground flaxseed"
    ],
    "fruits": [],
    "berries": [],
    "tubers": [],
    "herbs_spices": [
      "1 tsp red pepper flakes",
      "1 tsp turmeric powder",
      "Salt"
    ],
    "lime_lemon_vinegar": [],
    "sweeteners": []
  },
  "all_ingredients_flat": "split chickpeas (chana dal), amaranth greens, onions, green chili, cilantro, cumin seeds, fennel seeds, red pepper flakes, grated ginger, ground flaxseed, turmeric powder, curry leaves, Salt",
  "instructions": "(1) GROUND CHANA DAL: Soak chana dal (split chickpeas) for 1-2 hours. Then grind them in a blender (without adding any water) into a coarse texture.\n(2) GREENS & MASALA: Mix thinly diced onions, green chilies, cilantro and amaranth greens with our hands, squeezing hard. Add cumin seeds, ground flaxseed, fennel seeds, red pepper flakes & grated ginger. Mix well. Add salt to taste.\n(3) VADAS: Combine Ground Chana Dal (from Step 1) with the Greens & Masala mixture (from Step 2). Mix well. Make small balls. Place them on a baking tray lined with parchment paper. Press them flat.\n(4) BAKE: Preheat the oven at 400 F. Place the baking tray with vadas in the oven. Bake for 10-15 minutes (until Vadas turn golden brown). Check in between to make sure that they don't burn.\n(5) SERVE: With homemade tomato sauce. They are nice and crunchy!",
  "cooking_methods": [
    "blend",
    "no-cook",
    "bake"
  ],
  "serving_suggestion": "With homemade tomato sauce. They are nice and crunchy!",
  "notes": "",
