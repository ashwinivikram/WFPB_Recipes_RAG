  "all_ingredients_flat": "80% cooked chickpeas, garlic, paprika, ground cumin, black pepper, salt, tahini, lemon juice, basil, lemon, walnuts, pumpkin seeds, Ezekiel 4:9 Low Sodium Bread, tomato, cucumber, arugula",
  "instructions": "HUMMUS: Blend 1 cup 80% cooked chickpeas, 2 cloves garlic, paprika, ground cumin, black pepper, salt (to taste), 2 tbsp tahini, 1 lemon juice. Add minimal water if needed. Blend on high until smooth.\nPESTO: Blend 2 cloves garlic (not more), 1 bunch basil, 1 lemon, ½ cup walnuts (or pumpkin seeds), water as needed (optional), 1/2 tsp salt.\nSANDWICH: Spread hummus and some pesto on Ezekiel 4:9 Low Sodium Bread. Add some tomato & cucumber, and a pile of arugula for a delectable sandwich!",
  "cooking_methods": [
    "blend",
    "no-cook"
  ],
  "serving_suggestion": "for a delectable sandwich!",
  "notes": "HUMMUS (sub-recipe), PESTO (sub-recipe)",
